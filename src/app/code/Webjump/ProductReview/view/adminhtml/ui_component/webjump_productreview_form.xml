<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">
                webjump_productreview_form.webjump_productreview_form_data_source
            </item>
        </item>
        <item name="label" xsi:type="string" translate="true">Informações da Avaliação</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="save" class="Webjump\ProductReview\Block\Adminhtml\Review\Edit\SaveButton"/>
            <button name="save_and_continue"
                    class="Webjump\ProductReview\Block\Adminhtml\Review\Edit\SaveAndContinueButton"/>
            <button name="delete" class="Webjump\ProductReview\Block\Adminhtml\Review\Edit\DeleteButton"/>
            <button name="back" class="Webjump\ProductReview\Block\Adminhtml\Review\Edit\BackButton"/>
        </buttons>
        <namespace>webjump_productreview_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>webjump_productreview_form.webjump_productreview_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="webjump_productreview_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="webjump_productreview/review/save"/>
        </settings>
        <dataProvider class="Webjump\ProductReview\Model\Review\DataProvider"
                      name="webjump_productreview_form_data_source">
            <settings>
                <requestFieldName>review_id</requestFieldName>
                <primaryFieldName>review_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general">
        <settings>
            <label translate="true">Dados Gerais</label>
        </settings>
        <field name="review_id" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">review</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
                <dataScope>review_id</dataScope>
            </settings>
        </field>
        <field name="product_id" sortOrder="10" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">review</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="array">
                        <item name="validate" xsi:type="boolean">true</item>
                        <item name="message" xsi:type="string" translate="true">Este campo é obrigatório.</item>
                    </rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">ID do Produto</label>
                <dataScope>product_id</dataScope>
                <notice translate="true">ID numérico do produto no catálogo associado a esta avaliação.</notice>
            </settings>
        </field>
        <field name="author_name" sortOrder="20" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">review</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="array">
                        <item name="validate" xsi:type="boolean">true</item>
                        <item name="message" xsi:type="string" translate="true">Este campo é obrigatório.</item>
                    </rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Nome do Autor</label>
                <dataScope>author_name</dataScope>
            </settings>
        </field>
        <field name="rating" sortOrder="30" formElement="select">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">review</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="array">
                        <item name="validate" xsi:type="boolean">true</item>
                        <item name="message" xsi:type="string" translate="true">Este campo é obrigatório.</item>
                    </rule>
                </validation>
                <dataType>number</dataType>
                <label translate="true">Nota</label>
                <dataScope>rating</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Webjump\ProductReview\Model\Source\RatingOptions"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="is_approved" sortOrder="40" formElement="select">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">review</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="array">
                        <item name="validate" xsi:type="boolean">true</item>
                        <item name="message" xsi:type="string" translate="true">Este campo é obrigatório.</item>
                    </rule>
                </validation>
                <dataType>number</dataType>
                <label translate="true">Status de Aprovação</label>
                <dataScope>is_approved</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Webjump\ProductReview\Model\Source\ApprovalStatus"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="comment" sortOrder="50" formElement="textarea">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">review</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="array">
                        <item name="validate" xsi:type="boolean">true</item>
                        <item name="message" xsi:type="string" translate="true">Este campo é obrigatório.</item>
                    </rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Comentário</label>
                <dataScope>comment</dataScope>
            </settings>
        </field>
    </fieldset>
</form>
