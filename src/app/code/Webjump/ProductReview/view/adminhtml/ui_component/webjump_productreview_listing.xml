<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">
                webjump_productreview_listing.webjump_productreview_listing_data_source
            </item>
        </item>
    </argument>
    <settings>
        <buttons>
            <button name="add">
                <url path="*/*/new"/>
                <class>primary</class>
                <label translate="true">Nova Avaliação</label>
            </button>
        </buttons>
        <spinner>webjump_productreview_columns</spinner>
        <deps>
            <dep>webjump_productreview_listing.webjump_productreview_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="webjump_productreview_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">review_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Webjump_ProductReview::reviews</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider"
                      name="webjump_productreview_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>review_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <massaction name="listing_massaction">
            <action name="approve">
                <settings>
                    <url path="webjump_productreview/review/massApprove"/>
                    <type>approve</type>
                    <label translate="true">Aprovar</label>
                </settings>
            </action>
            <action name="disapprove">
                <settings>
                    <url path="webjump_productreview/review/massDisapprove"/>
                    <type>disapprove</type>
                    <label translate="true">Reprovar / Pendente</label>
                </settings>
            </action>
            <action name="delete">
                <settings>
                    <confirm>
                        <title translate="true">Excluir Avaliações</title>
                        <message translate="true">Tem certeza que deseja excluir as avaliações selecionadas?</message>
                    </confirm>
                    <url path="webjump_productreview/review/massDelete"/>
                    <type>delete</type>
                    <label translate="true">Excluir</label>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging"/>
        <exportButton name="export_button">
            <settings>
                <options>
                    <option name="csv" xsi:type="array">
                        <item name="value" xsi:type="string">csv</item>
                        <item name="label" xsi:type="string" translate="true">CSV</item>
                        <item name="url" xsi:type="string">webjump_productreview/export/gridToCsv</item>
                    </option>
                    <option name="xml" xsi:type="array">
                        <item name="value" xsi:type="string">xml</item>
                        <item name="label" xsi:type="string" translate="true">Excel XML</item>
                        <item name="url" xsi:type="string">webjump_productreview/export/gridToXml</item>
                    </option>
                </options>
                <selectProvider>
                    webjump_productreview_listing.webjump_productreview_listing.webjump_productreview_columns.ids
                </selectProvider>
            </settings>
        </exportButton>
    </listingToolbar>
    <columns name="webjump_productreview_columns">
        <selectionsColumn name="ids">
            <settings>
                <indexField>review_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="review_id">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>desc</sorting>
            </settings>
        </column>
        <column name="product_id">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID do Produto</label>
            </settings>
        </column>
        <column name="author_name">
            <settings>
                <filter>text</filter>
                <label translate="true">Autor</label>
            </settings>
        </column>
        <column name="comment">
            <settings>
                <filter>text</filter>
                <label translate="true">Comentário</label>
            </settings>
        </column>
        <column name="rating">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Nota</label>
            </settings>
        </column>
        <column name="is_approved" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <options class="Webjump\ProductReview\Model\Source\ApprovalStatus"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Status de Aprovação</label>
            </settings>
        </column>
        <column name="created_at"
                class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Criado em</label>
            </settings>
        </column>
        <column name="updated_at"
                class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Atualizado em</label>
            </settings>
        </column>
        <actionsColumn name="actions"
                       class="Webjump\ProductReview\Ui\Component\Listing\Column\ReviewActions">
            <settings>
                <indexField>review_id</indexField>
                <resizeEnabled>false</resizeEnabled>
                <resizeDefaultWidth>120</resizeDefaultWidth>
            </settings>
        </actionsColumn>
    </columns>
</listing>
