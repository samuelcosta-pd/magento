<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="product.info.details">
            <block class="Magento\Catalog\Block\Product\View"
                   name="product.info.webjump_reviews"
                   template="Webjump_ProductReview::product/view/reviews.phtml"
                   group="detailed_info">
                <arguments>
                    <argument name="title" translate="true" xsi:type="string">Avaliações Customizadas</argument>
                    <argument name="reviews_view_model"
                              xsi:type="object">Webjump\ProductReview\ViewModel\ProductReviews</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
