<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd" extends="pagebuilder_base_form">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">pagebuilder_spooky_coffin_form.pagebuilder_spooky_coffin_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Caixão de Ofertas</item>
    </argument>
    <settings>
        <deps>
            <dep>pagebuilder_spooky_coffin_form.pagebuilder_spooky_coffin_form_data_source</dep>
        </deps>
        <namespace>pagebuilder_spooky_coffin_form</namespace>
    </settings>
    <dataSource name="pagebuilder_spooky_coffin_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_PageBuilder/js/form/provider</item>
            </item>
        </argument>
        <dataProvider name="pagebuilder_spooky_coffin_form_data_source" class="Magento\PageBuilder\Model\ContentType\DataProvider">
            <settings>
                <requestFieldName/>
                <primaryFieldName/>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="appearance_fieldset" sortOrder="10" component="Magento_PageBuilder/js/form/element/dependent-fieldset">
        <settings>
            <label translate="true">Aparência</label>
            <collapsible>false</collapsible>
            <opened>true</opened>
        </settings>
        <field name="appearance" formElement="select" sortOrder="10">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">default</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options>
                            <option name="default" xsi:type="array">
                                <item name="value" xsi:type="string">default</item>
                                <item name="label" xsi:type="string" translate="true">Padrão</item>
                            </option>
                        </options>
                    </settings>
                </select>
            </formElements>
        </field>
    </fieldset>
    <fieldset name="general" sortOrder="20">
        <settings>
            <label translate="true">Configurações da Oferta Assombrada</label>
            <collapsible>true</collapsible>
            <opened>true</opened>
        </settings>
        <field name="offer_title" sortOrder="10" formElement="input">
            <settings>
                <label translate="true">Título da Oferta</label>
                <dataType>text</dataType>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="offer_badge" sortOrder="20" formElement="input">
            <settings>
                <label translate="true">Selo Promocional</label>
                <dataType>text</dataType>
                <notice translate="true">Exemplo: 🎃 OFERTA ASSOMBRADA ou 50% OFF</notice>
            </settings>
        </field>
        <field name="offer_description" sortOrder="30" formElement="textarea">
            <settings>
                <label translate="true">Descrição da Oferta</label>
                <dataType>text</dataType>
            </settings>
        </field>
        <field name="image" sortOrder="40" formElement="imageUploader">
            <settings>
                <label translate="true">Imagem da Oferta</label>
                <componentType>imageUploader</componentType>
            </settings>
            <formElements>
                <imageUploader>
                    <settings>
                        <allowedExtensions>jpg jpeg gif png webp svg</allowedExtensions>
                        <maxFileSize>4194304</maxFileSize>
                        <uploaderConfig>
                            <param xsi:type="string" name="url">pagebuilder/contenttype/image_upload</param>
                        </uploaderConfig>
                        <previewTmpl>Magento_PageBuilder/form/element/uploader/preview</previewTmpl>
                    </settings>
                </imageUploader>
            </formElements>
        </field>
        <urlInput name="link_url" sortOrder="50">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Link da Oferta</label>
                <dataScope>link_url</dataScope>
                <urlTypes class="Magento\Ui\Model\UrlInput\LinksConfigProvider"/>
            </settings>
        </urlInput>
        <field name="button_text" sortOrder="60" formElement="input">
            <settings>
                <label translate="true">Texto do Botão (CTA)</label>
                <dataType>text</dataType>
            </settings>
        </field>
    </fieldset>
</form>
