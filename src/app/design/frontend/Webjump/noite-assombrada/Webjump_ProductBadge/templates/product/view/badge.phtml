<?php
/**
 * Copyright © Webjump. All rights reserved.
 *
 * @var \Magento\Catalog\Block\Product\View $block
 * @var \Magento\Framework\Escaper $escaper
 */

$_product = $block->getProduct();
/** @var \Webjump\ProductBadge\ViewModel\Badge|null $badgeViewModel */
$badgeViewModel = $block->getData('badge_view_model');

if (!$badgeViewModel instanceof \Webjump\ProductBadge\ViewModel\Badge || !$badgeViewModel->hasBadge($_product)) {
    return;
}

$badgeLabel = (string) $badgeViewModel->getBadgeLabel($_product);
$badgeClass = (string) $badgeViewModel->getBadgeCssClass($_product);
?>
<div class="product-badge-wrapper product-badge-wrapper--pdp" data-role="product-badge">
    <span class="product-badge <?= $escaper->escapeHtmlAttr($badgeClass) ?>"
          title="<?= $escaper->escapeHtmlAttr(__($badgeLabel)) ?>">
        <span class="product-badge-icon" aria-hidden="true">🎃</span>
        <span class="product-badge-text">
            <?= $escaper->escapeHtml(__($badgeLabel)) ?>
        </span>
    </span>
</div>
