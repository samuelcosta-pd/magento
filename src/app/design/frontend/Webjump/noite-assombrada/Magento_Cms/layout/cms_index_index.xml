<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template"
                   name="halloween.countdown.home"
                   template="Magento_Theme::html/countdown.phtml"
                   before="-">
                <arguments>
                    <argument name="target_date" xsi:type="string">2026-10-31T23:59:59</argument>
                    <argument name="extra_class" xsi:type="string">halloween-countdown--home</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
