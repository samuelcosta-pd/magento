<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template"
                   name="spirit.home.page"
                   template="Magento_Cms::home/spirit-home.phtml"
                   before="-">
                <arguments>
                    <argument name="view_model" xsi:type="object">Webjump\Samuel\ViewModel\Home</argument>
                </arguments>
            </block>
        </referenceContainer>

        <!-- Hide default legacy home elements if any -->
        <referenceBlock name="webjump.samuel.home.block" remove="true"/>
    </body>
</page>
